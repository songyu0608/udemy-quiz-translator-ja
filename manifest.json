{
    "manifest_version":  3,
    "name":  "Udemy Quiz Translator (JA)",
    "short_name":  "Udemy Quiz JA",
    "version":  "1.5.1",
    "description":  "Udemy 퀴즈를 Chrome 내장 Translator API로 일본어로 로컬 번역하고 문제 옆(오른쪽 또는 아래)에 표시합니다.",
    "minimum_chrome_version":  "138",
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://www.udemy.com/*",
                                                "https://udemy.com/*"
                                            ],
                                "js":  [
                                           "dictionary-terms.js",
                                           "dictionary.js",
                                           "content.js"
                                       ],
                                "run_at":  "document_idle",
                                "world":  "MAIN",
                                "all_frames":  false
                            }
                        ]
}